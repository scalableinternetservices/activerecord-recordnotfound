<h2><%= @post.post_name %></h2>
<p><%= @post.body %></p>
<p>Posted by: <%= @post.user.user_name %> on <%= @post.created_at.strftime("%B %d, %Y %H:%M") %></p>

<% if @post.user == current_user %>
  <%= button_to 'Edit Post', edit_group_post_path(@group, @post), method: :get, class: 'edit-button' %>
  <%= button_to 'Delete Post', group_post_path(@group, @post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'delete-button' %>
<% end %>

<h3>Comments</h3>
<% @post.comments.each do |comment| %>
  <p>
    <strong><%= comment.user.user_name %>:</strong> <%= comment.body %>
    <% if comment.user == current_user %>
      <%= button_to "Delete", group_post_comment_path(@group, @post, comment), method: :delete, data: { confirm: "Are you sure?" }, class: "delete-button" %>
    <% end %>
  </p>
<% end %>

<h3>Add a Comment</h3>
<% if current_user.in_group?(@group) %>
  <%= form_with model: [@group, @post, @post.comments.build], local: true do |form| %>
    <div class="form-group">
      <%= form.label :body %>
      <%= form.text_area :body, rows: 3, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= form.submit "Post Comment", class: "btn btn-primary" %>
    </div>
  <% end %> <!-- Closing form_with -->
<% else %>
  <p>You need to join this group to add comments.</p>
<% end %>





