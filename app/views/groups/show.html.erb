<div class="group-container">
    <h2><%= @group.group_name %></h2>

    <div class="group-details">
        <p><strong><%= @group.count_users_in_group(@group.id) %> Members</strong></p>
        <p><strong>Admin:</strong> <%= @group.admin.user_name %></p>
    </div>

    <div class="group-actions">
        <% if current_user.in_group?(@group.id) %>
            <% if @group.admin_id == current_user.id %>
                <%= button_to 'Delete Group', group_path(@group), method: :delete, data: { confirm: 'Are you sure?' }, class: 'delete-button' %>
            <% else %>
                <%= button_to 'Leave Group', leave_group_group_path(@group), method: :post, data: { confirm: 'Are you sure?' }, class: 'leave-button' %>
            <% end %>
        <% else %>
            <%= button_to 'Join Group', join_group_group_path(@group), method: :post, class: 'join-button' %>
        <% end %>
    </div>

    <section class="posts-section">
      <% cache(cache_key_for_post_section) do %>
        <h3>Posts</h3>
        <% if current_user.in_group?(@group.id) %>
            <div class="new-post-button">
                <%= link_to 'Create New Post', new_group_post_path(@group), class: "create-button" %>
            </div>
        <% else %>
            <p>You need to join this group to create posts.</p>
        <% end %>

        <% if @posts.any? %>
            <ul class="post-list">
                <% @posts.each do |post| %>
                  <% cache(cache_key_for_post(post)) do %>
                    <li class="post-item">
                        <%= link_to post.post_name.presence || "Untitled Post", group_post_path(post.group, post), class: "post-link" %>
                        <span class="post-author">by <%= post.user.user_name %></span>
                    </li>
                  <% end %>
                <% end %>
            </ul>
            <div class="pagination">
                <% if @current_page > 1 %>
                    <%= link_to 'Previous', group_path(@group, page: @current_page - 1), class: 'page' %>
                <% end %>
                <% if @current_page < @total_pages %>
                    <%= link_to 'Next', group_path(@group, page: @current_page + 1), class: 'page' %>
                <% end %>
            </div>

        <% else %>
            <p class="no-posts">No posts yet.</p>
        <% end %>
      <% end %>
    </section>
</div>
