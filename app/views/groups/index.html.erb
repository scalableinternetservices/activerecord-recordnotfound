<div class=group-container>
  <h2>Search for Groups</h2>
  <div class="search-section">
    <%= form_with url: groups_path,
                  method: :get,
                  local: false,
                  class: "search-form",
                  data: { turbo_frame: 'results' } do |f| %>
      <%= f.text_field :search, 
          placeholder: "Search by group...", 
          value: params[:search],
          class: "search-input" %>
      <%= f.submit "Search", class: "search-button" %>
    <% end %>
  </div>
</div>

<div class="group-container">
    <h2>Your Groups</h2>

    <div id="your-groups" class="users-list">
        <% if @your_groups.any? %>
            <%= render @your_groups %>
        <% else %>
            <p class="no-results">No groups found.</p>
        <% end %>
        <% if @pagy_your_groups.next %>
            <%= render "load_more_button",
                        pagy: @pagy_your_groups,
                        page_params: { page_your_groups: @pagy_your_groups.next,
                                       page_explore_groups: params[:page_explore_groups] } %>
        <% end %>
    </div>
    <div class="new-group-button-wrapper">
        <%= link_to 'Create New Group', new_group_path, class: 'new-group-button' %>
    </div>
</div>

<div class="group-container">
    <h2>Your Groups</h2>

    <div id="explore-groups" class="users-list">
        <% if @explore_groups.any? %>
            <%= render @explore_groups %>
        <% else %>
            <p class="no-results">No groups found.</p>
        <% end %>
        <div class="flex justify-center" id="load_more_button">
            <%= render "load_more_button",
                    pagy: @pagy_explore_groups,
                    page_params: { page_your_groups: params[:page_your_groups],
                                   page_explore_groups: @pagy_explore_groups.next } %>
        </div>
    </div>
</div>